{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**", "src/generated.ts"]
    },
    "lint": {
      "dependsOn": ["build", "^build"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "build-storybook": {
      "dependsOn": ["build", "^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
