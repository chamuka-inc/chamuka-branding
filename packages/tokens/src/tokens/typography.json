{
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Sora", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "sans": {
      "$value": ["IBM Plex Sans", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "mono": {
      "$value": ["IBM Plex Mono", "ui-monospace", "monospace"]
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": "400" },
    "medium": { "$value": "500" },
    "semibold": { "$value": "600" },
    "bold": { "$value": "700" }
  },
  "fontSize": {
    "$type": "dimension",
    "display": { "$value": "56px", "$description": "Sora 600 / 64" },
    "h1": { "$value": "40px" },
    "h2": { "$value": "32px" },
    "h3": { "$value": "24px" },
    "h4": { "$value": "20px" },
    "body": { "$value": "16px" },
    "small": { "$value": "14px" },
    "caption": { "$value": "12px" },
    "code": { "$value": "14px" }
  },
  "lineHeight": {
    "$type": "number",
    "display": { "$value": "64px" },
    "h1": { "$value": "48px" },
    "h2": { "$value": "40px" },
    "h3": { "$value": "32px" },
    "h4": { "$value": "28px" },
    "body": { "$value": "24px" },
    "small": { "$value": "20px" },
    "caption": { "$value": "16px" },
    "code": { "$value": "22px" }
  }
}
