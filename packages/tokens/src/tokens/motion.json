{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "300ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  }
}
