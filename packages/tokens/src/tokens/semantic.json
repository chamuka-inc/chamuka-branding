{
  "semantic": {
    "$type": "color",
    "light": {
      "$description": "Shadcn-style semantic colours for the light theme (:root).",
      "background": { "$value": "{color.paper}" },
      "foreground": { "$value": "{color.ink}" },
      "card": { "$value": "{color.paper}" },
      "card-foreground": { "$value": "{color.ink}" },
      "popover": { "$value": "#FFFFFF" },
      "popover-foreground": { "$value": "{color.ink}" },
      "primary": { "$value": "{color.ember}" },
      "primary-foreground": {
        "$value": "#FFFFFF",
        "$description": "Large UI only; ember fails WCAG AA for small text on paper (3.74:1)."
      },
      "secondary": { "$value": "{color.mist}" },
      "secondary-foreground": { "$value": "{color.ink}" },
      "muted-bg": { "$value": "{color.mist}" },
      "muted-foreground": { "$value": "{color.muted}" },
      "accent": { "$value": "{color.slate}" },
      "accent-foreground": { "$value": "{color.paper}" },
      "destructive": { "$value": "{color.danger}" },
      "destructive-foreground": { "$value": "#FFFFFF" },
      "border": { "$value": "#E6D9C8" },
      "input": { "$value": "#E6D9C8" },
      "ring": { "$value": "{color.ember}" },
      "accent-drawit": { "$value": "{color.ember}" },
      "accent-formit": { "$value": "{color.slate}" },
      "accent-play": { "$value": "{color.play}" },
      "accent-forest": { "$value": "{color.forest}" },
      "accent-mineral": { "$value": "{color.mineral}" }
    },
    "dark": {
      "$description": "Semantic overrides for .dark and [data-theme=dark].",
      "background": { "$value": "#17141C" },
      "foreground": { "$value": "#FFF8F1" },
      "card": { "$value": "#241F1C" },
      "card-foreground": { "$value": "#FFF8F1" },
      "popover": { "$value": "#241F1C" },
      "popover-foreground": { "$value": "#FFF8F1" },
      "primary": {
        "$value": "#F06A3A",
        "$description": "Slightly lifted ember so filled buttons hold contrast on ink."
      },
      "primary-foreground": { "$value": "#17141C" },
      "secondary": { "$value": "#3A3531" },
      "secondary-foreground": { "$value": "#FFF8F1" },
      "muted-bg": { "$value": "#241F1C" },
      "muted-foreground": { "$value": "#A39484" },
      "accent": {
        "$value": "#7FA0D4",
        "$description": "Lifted slate for text/links on ink; fills may still use #2B4C7E."
      },
      "accent-foreground": { "$value": "#17141C" },
      "destructive": { "$value": "#E0564A" },
      "destructive-foreground": { "$value": "#17141C" },
      "border": { "$value": "#3A3531" },
      "input": { "$value": "#3A3531" },
      "ring": { "$value": "#F06A3A" }
    }
  }
}
