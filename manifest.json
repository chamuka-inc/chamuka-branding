  "tokens": [
    {
      "path": "color.ember",
      "cssVar": "--ember",
      "value": "#E24E1B",
      "description": "Master primary. DrawIt accent. Not body text on paper."
    },
    {
      "path": "color.gold",
      "cssVar": "--gold",
      "value": "#E6B422",
      "description": "Horizon bar and highlights. Never a product accent."
