{
  "name": "chamuka-design",
  "brand": "Daybreak",
  "repository": "https://github.com/chamuka-labs/chamuka-design",
  "packages": [
    "@chamuka/tokens",
    "@chamuka/ui",
    "@chamuka/icons"
  ],
  "registry": "https://raw.githubusercontent.com/chamuka-labs/chamuka-design/main/registry/registry.json",
  "behaviour": {
    "ui-sdk": "Interactive components wrap @ui-sdk/react 0.1.0-beta.2. Do not import UI SDK types from @chamuka/ui.",
    "radix": "Avatar and Separator still use Radix.",
    "plain": "Presentational components are React + Tailwind + cva."
  },
  "components": [
    {
      "name": "Button",
      "slug": "button",
      "import": {
        "named": [
          "Button",
          "buttonVariants"
        ],
        "from": "@chamuka/ui"
      },
      "file": "packages/ui/src/button.tsx",
      "description": "Primary action control. Ember fill; 16px default so ember-on-paper meets AA large.",
      "behaviour": "plain",
      "behaviourReason": "Presentational. Uses Radix Slot only for asChild.",
      "variants": {
        "variant": [
          "default",
          "primary",
          "secondary",
          "outline",
          "ghost",
          "destructive",
          "link"
        ],
        "size": [
          "default",
          "md",
          "sm",
          "lg",
          "icon"
        ]
      },
      "props": [],
      "a11y": "Focus-visible ring. Disabled is pointer-events-none + opacity. Ember labels stay at 14px minimum, medium weight.",
      "example": "<Button>Save</Button>",
      "registry": "https://raw.githubusercontent.com/chamuka-labs/chamuka-design/main/registry/button.json"
    },
    {
      "name": "IconButton",
      "slug": "icon-button",
      "import": {
        "named": [
          "IconButton"
        ],
        "from": "@chamuka/ui"
      },
      "file": "packages/ui/src/icon-button.tsx",
      "description": "Square icon-only button. Requires a visible-name `label`.",
      "behaviour": "plain",
      "behaviourReason": "Presentational wrapper around Button.",
      "variants": {},
      "props": [],
      "a11y": "Sets aria-label from `label`. Pair with Lucide at 1.5–2px stroke.",
      "example": "<IconButton label=\"Close\"><span aria-hidden>×</span></IconButton>",
      "registry": "https://raw.githubusercontent.com/chamuka-labs/chamuka-design/main/registry/icon-button.json"
    },
