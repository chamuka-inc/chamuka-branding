      "description": "Text link in primary (ember).",
      "behaviour": "plain",
      "behaviourReason": "Presentational.",
      "variants": {},
      "props": [],
      "a11y": "Focus-visible ring. Use asChild to render a router Link.",
      "example": "<Link href=\"https://chamuka.ai\">chamuka.ai</Link>",
      "registry": "https://raw.githubusercontent.com/chamuka-labs/chamuka-design/main/registry/link.json"
    },
